---
// import { ClientRouter } from "astro:transitions";
import ScrollToTop from "../components/ScrollToTop.astro";
import { Icon } from "astro-icon/components";
import "../styles/global.css";
import "../assets/scss/main.scss";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: URL | string;
}

const {
  title = "Conference",
  description = "lorem ipsum dolor sit amet",
  ogImage = "/seo/meta_image.jpg", // Make sure this is in your public/ folder
  canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://stefdev.org")
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url)} />

    <slot name="head" />

    <title>{title}</title>
  
    <script is:inline>
      if (sessionStorage.getItem("visited")) {
        document.documentElement.classList.add("preloader-skipped");
      }
    </script>
    
    <style>
      /* Immediately hide the curtain if the skip class is present on <html> */
      :global(.preloader-skipped) #transition-curtain {
        display: none !important;
      }
    </style>

  </head>
  <body
    class="bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col relative"
  >
    <div
      id="transition-curtain"
      class="fixed inset-0 bg-(--dark) z-[9999] pointer-events-auto flex items-center justify-center"
    >
      <div id="preloader-logo" class="text-white font-bold text-3xl tracking-widest opacity-0">
        <img src="/logo_light.svg" alt="StefDev" class="w-5rem"/>
      </div>
    </div>

    <!-- <div class="cursor-follower"></div> -->

    <!-- <div class="gradient-top" style="--top: 0%; --right: 0%;"></div> -->

    <header class="site-header">
      <div class="container mx-auto flex justify-between items-center">
        <a href="/" class="header-logo">
          <img src="/logo.svg" alt="Conference" />
        </a>
        <nav class="main-navigation flex justify-end">
          <ul class="flex gap-3">
            <!-- <li><a href="/">Home</a></li> -->
            <!-- <li><a href="/projects" class="underline-effect py-2">projects</a></li>
            <li><a href="/contact" class="underline-effect py-2">contact</a></li> -->
            <li><a href="/#about-marker" class="scrollto underline-effect py-2">About</a></li>
            <li><a href="/#agenda-marker" class="scrollto underline-effect py-2">Agenda</a></li>
            <li><a href="/#speakers-marker" class="scrollto underline-effect py-2">Speakers</a></li>
            <li><a href="/#contact-marker" class="scrollto underline-effect py-2">Contact</a></li>
          </ul>
        </nav>
        <button id="navBtn" class="md:hidden" aria-label="Toggle mobile menu">
          <span class="line line1"></span>
          <span class="line line2"></span>
          <span class="line line3"></span>
        </button>
        <nav class="mobile-menu">
          <!-- <button id="close-menu" aria-label="Close menu">
            <Icon name="close" class="w-8 h-8" />
          </button> -->
          <ul>
            <li><a href="/#about-marker" class="drawer-link underline-effect py-2">About</a></li>
            <li><a href="/#agenda-marker" class="drawer-link underline-effect py-2">Agenda</a></li>
            <li><a href="/#speakers-marker" class="drawer-link underline-effect py-2">Speakers</a></li>
            <li><a href="/#contact-marker" class="drawer-link underline-effect py-2">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>
    <ScrollToTop />

    <span id="contact-marker"></span>
    <footer class="site-footer bg-(--idrs-primary-800) text-white border-t border-slate-600 py-5" id="main-footer">
      <div class="container h-full">
        <div class="content flex flex-col gap-5 sm:flex-row sm:gap-10 justify-between items-center">
          <a href="/" class="footer-logo">
            <img src="/logo.svg" alt="Conference" class="h-[5rem]"/>
          </a>
          <p class="font2-regular text-muted text-center sm:text-justify">© 2026 IDRS · Skopje · International Conference on Dispute Resolution</p>
        </div>
      </div>
    </footer>

    <!-- <div class="glow-gradient" style="--right: 0%; --bottom: 0%;"></div> -->

    <script src="../assets/js/main.js"></script>

  </body>
</html>

<script>
  import { gsap } from "gsap";
  import Lenis from "lenis";

  declare global {
    interface Window {
      lenis: Lenis | undefined;
    }
  }

  function initSmoothScroll() {
    const isTouch = window.matchMedia("(pointer: coarse)").matches;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Native momentum scroll on touch / reduced-motion — Lenis only on pointer devices.
    if (isTouch || prefersReducedMotion) return;

    window.lenis = new Lenis({
      duration: 1.2,
      anchors: true,
    });

    gsap.ticker.add((time) => window.lenis?.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  // Custom Cursor Follower
  // const initCursor = () => {
  //   if ("ontouchstart" in window) return;
  //   const $el = document.querySelector(".cursor-follower");
  //   if (!$el) return;

  //   const updateCursor = (e: MouseEvent) => {
  //     const { target, clientX, clientY } = e;
  //     const isTargetLinkOrBtn = (target as HTMLElement)?.closest("a") || (target as HTMLElement)?.closest("button");

  //     gsap.to($el, {
  //       x: clientX + 3,
  //       y: clientY + 3,
  //       duration: 0.7,
  //       ease: "power4.out",
  //       opacity: isTargetLinkOrBtn ? 0.6 : 1,
  //       scale: isTargetLinkOrBtn ? 3 : 1,
  //     });
  //   };

  //   const hideCursor = () => {
  //     gsap.to($el, { duration: 0.7, opacity: 0 });
  //   };

  //   document.addEventListener("mousemove", updateCursor);
  //   document.addEventListener("mouseleave", hideCursor);
  // };

  // Preloader Logic
  const initPreloader = () => {
    const curtain = document.getElementById("transition-curtain");
    const logo = document.getElementById("preloader-logo");
    const hasVisited = sessionStorage.getItem("visited");

    if (hasVisited && curtain) {
      curtain.remove();
      document.dispatchEvent(new CustomEvent("preloaderFinished"));
      return;
    }

    // Accessibility: no curtain animation for reduced-motion users — straight to content.
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion && curtain) {
      curtain.remove();
      sessionStorage.setItem("visited", "true");
      document.dispatchEvent(new CustomEvent("preloaderFinished"));
      return;
    }

    if (curtain) {
      const tl = gsap.timeline({
        onComplete: () => {
          curtain.remove();
          sessionStorage.setItem("visited", "true");
          document.dispatchEvent(new CustomEvent("preloaderFinished"));
        }
      });

      // Logo fades in, then the whole curtain (logo included) sweeps up and out.
      tl.to(logo, { opacity: 1, y: -8, duration: 0.3, ease: "power2.out" })
        .to(curtain, { yPercent: -100, duration: 0.5, ease: "power3.inOut" }, "-=0.05");
    }
  };

  // Run initialization
  initSmoothScroll();
  // initCursor();
  initPreloader();
</script>
