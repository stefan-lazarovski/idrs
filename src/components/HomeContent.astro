---
// src/components/HomeContent.astro
import { Icon } from "astro-icon/components";
import { useTranslations } from "../i18n/utils";
import { agenda, speakers } from "../i18n/ui";

import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const locale = (lang === "en" ? "en" : "mk") as "mk" | "en";
const t = useTranslations(locale);
const agendaDays = agenda[locale];
const speakerList = speakers[locale];
---

<div data-astro-transition="none">
  <section class="hero-banner">
    <img src="/shape.png" alt="IDRS" class="shape" />
    <div class="hero-wrapper h-full border">
      <div class="container h-full flex items-center">
        <div class="content text-white lg:w-2/3">
          <p class="badge mb-7">
            <span>{t("hero.badge1")}</span> ·
            <span>{t("hero.badge2")}</span> ·
            <span>{t("hero.badge3")}</span>
          </p>
          <h1 class="!text-white mb-10">{t("hero.title")}</h1>
          <p class="text-slate-400 mb-10">{t("hero.lead")}</p>
          <div class="flex flex-col md:flex-row gap-5 md:gap-10 mb-10">
            <p class="flex items-center gap-3 font2-regular whitespace-nowrap">
              <Icon name="diamond" class="w-3 h-3 text-yellow-500" />
              {t("hero.date")}
            </p>
            <p class="flex items-center gap-3 font2-regular whitespace-nowrap">
              <Icon name="diamond" class="w-3 h-3 text-yellow-500" />
              {t("hero.venue")}
            </p>
          </div>
          <div class="idrs-countdown">
            <div class="idrs-countdown__grid grid grid-cols-2 gap-5 md:grid-cols-4">
              <div class="idrs-tile">
                <span class="idrs-tile__num" id="cd-days">--</span>
                <span class="idrs-tile__unit">{t("countdown.days")}</span>
              </div>
              <div class="idrs-tile">
                <span class="idrs-tile__num" id="cd-hours">--</span>
                <span class="idrs-tile__unit">{t("countdown.hours")}</span>
              </div>
              <div class="idrs-tile">
                <span class="idrs-tile__num" id="cd-minutes">--</span>
                <span class="idrs-tile__unit">{t("countdown.minutes")}</span>
              </div>
              <div class="idrs-tile idrs-tile--accent">
                <span class="idrs-tile__num" id="cd-seconds">--</span>
                <span class="idrs-tile__unit">{t("countdown.seconds")}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <span id="about-marker"></span>
  <section class="about-section section-padding--y">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-10">
        <div class="col-left">
          <p class="supertitle mb-5 text-gold font-medium">{t("about.supertitle")}</p>
          <h2 class="section-title">{t("about.title")}</h2>
        </div>
        <div class="col-right">
          <p class="mb-5">{t("about.p1")}</p>
          <p class="mb-10">{t("about.p2")}</p>
          <div class="stats flex gap-5 lg:gap-10">
            <div class="stat--item border-t-2 border-yellow-500 pt-5">
              <p class="text-4xl mb-3 font1-semibold text-(--idrs-primary-700)">2</p>
              <p class="text-sm">{t("about.stat1Label")}</p>
            </div>
            <div class="stat--item border-t-2 border-yellow-500 pt-5">
              <p class="text-4xl mb-3 font1-semibold text-(--idrs-primary-700)">20+</p>
              <p class="text-sm">{t("about.stat2Label")}</p>
            </div>
            <div class="stat--item border-t-2 border-yellow-500 pt-5">
              <p class="text-4xl mb-3 font1-semibold text-(--idrs-primary-700)">12</p>
              <p class="text-sm">{t("about.stat3Label")}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <span id="agenda-marker"></span>
  <section class="agenda-section section-padding--y bg-gradient">
    <div class="container">
      <div class="section-header mb-5">
        <p class="supertitle mb-5 text-accent">{t("agenda.supertitle")}</p>
        <h2 class="section-title mb-3 !text-white">{t("agenda.title")}</h2>
        <p class="text-(--idrs-text-on-dark-muted)">{t("agenda.subtitle")}</p>
      </div>
      <div class="agenda-wrapper grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20">
        {
          agendaDays.map((day) => (
            <div class="col">
              <div class="flex gap-5 border-b border-slate-600 py-5">
                <span class="text-accent text-2xl font1-bold">{day.label}</span>
                <span class="text-(--idrs-text-on-dark-muted) font2-regular uppercase">
                  {day.theme}
                </span>
              </div>
              {day.sessions.map((s) => (
                <div class="flex gap-5 lg:gap-10 border-b border-slate-600 py-5">
                  <span class="time text-accent font1-regular">{s.time}</span>
                  <div class="flex flex-col">
                    <span class="text-white font1-bold">{s.title}</span>
                    <span class="text-(--idrs-text-on-dark-muted)">{s.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <span id="speakers-marker"></span>
  <section class="speakers section-padding--y bg-light">
    <div class="container">
      <div class="section-header mb-10">
        <p class="supertitle text-gold mb-3">{t("speakers.supertitle")}</p>
        <h2 class="section-title">{t("speakers.title")}</h2>
      </div>
      <div class="speakers-wrapper grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-10">
        {
          speakerList.map((sp) => (
            <div class="speaker-card p-5 bg-white w-fit rounded-lg">
              <div class="thumbnail mb-5">
                <img
                  src={sp.image}
                  alt={sp.name}
                  loading="lazy"
                  class="w-full h-full object-cover rounded-lg"
                />
              </div>
              <h4>{sp.name}</h4>
              <span class="block mb-5 text-sm text-gold font2-regular">{sp.role}</span>
              <p class="leading-[1.5] text-sm">{sp.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <span id="contact-marker"></span>
  <section class="getintouch bg-gradient text-white section-padding--y">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <div class="col-text">
          <p class="supertitle text-accent mb-3">{t("contact.supertitle")}</p>
          <h2 class="section-title !text-white mb-10 lg:mb-[2vw]">{t("contact.title")}</h2>
          <div class="info">
            <div class="info-box mb-7">
              <p class="text-sm text-muted mb-2 uppercase font2-regular tracking-[.25em]">
                {t("contact.venueLabel")}
              </p>
              <p>
                {t("contact.venueName")}<br />
                {t("contact.venueStreet")}<br />
                {t("contact.venueCountry")}
              </p>
            </div>
            <div class="flex gap-10 mb-7">
              <div class="info-box">
                <p class="text-sm text-muted mb-2 uppercase font2-regular tracking-[.25em]">
                  {t("contact.phoneLabel")}
                </p>
                <a href="tel:+38923001200" class="underline-effect">+389 2 300 1200</a>
              </div>
              <div class="info-box">
                <p class="text-sm text-muted mb-2 uppercase font2-regular tracking-[.25em]">
                  {t("contact.emailLabel")}
                </p>
                <a href="mailto:info@idrs.mk" class="underline-effect">info@idrs.mk</a>
              </div>
            </div>
            <div class="info-box mb-7">
              <p class="text-sm text-muted mb-2 uppercase font2-regular tracking-[.25em]">
                {t("contact.organizerLabel")}
              </p>
              <p>{t("contact.organizer")}</p>
            </div>
          </div>
        </div>
        <div class="col-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5134.199090901657!2d20.80096337729617!3d41.07604661524744!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1350c3611117153b%3A0x84c34dab510b125b!2sHotel%20Tino%20Sveti%20Stefan!5e1!3m2!1sen!2smk!4v1787232213824!5m2!1sen!2smk"
            width="100%"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  // Countdown to opening — 12 Nov 2026, 09:00 CET (+01:00)
  (function () {
    const target = new Date("2026-11-12T09:00:00+01:00").getTime();
    const els = {
      days: document.getElementById("cd-days"),
      hours: document.getElementById("cd-hours"),
      minutes: document.getElementById("cd-minutes"),
      seconds: document.getElementById("cd-seconds"),
    };
    const pad = (n: number) => String(n).padStart(2, "0");

    function tick() {
      let diff = Math.max(0, target - Date.now());
      const d = Math.floor(diff / 86400000);
      diff -= d * 86400000;
      const h = Math.floor(diff / 3600000);
      diff -= h * 3600000;
      const m = Math.floor(diff / 60000);
      diff -= m * 60000;
      const s = Math.floor(diff / 1000);

      if (els.days) els.days.textContent = pad(d);
      if (els.hours) els.hours.textContent = pad(h);
      if (els.minutes) els.minutes.textContent = pad(m);
      if (els.seconds) els.seconds.textContent = pad(s);
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>
