---
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, defaultLang } from "../i18n/ui";

const currentLocale = (Astro.currentLocale ?? defaultLang) as keyof typeof languages;

// Astro.url.pathname includes the base ("/idrs") AND, for non-default locales,
// the locale segment ("/en"). getRelativeLocaleUrl adds BOTH back, so strip
// both here first — otherwise you get /idrs/en/idrs/.
const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // "/idrs" (or "" at root)

function toCleanPath(pathname: string): string {
  let path = pathname;

  // 1. drop the base prefix
  if (base && (path === base || path.startsWith(base + "/"))) {
    path = path.slice(base.length) || "/";
  }

  // 2. drop a leading locale segment (only non-default locales have one)
  const segments = path.split("/"); // ["", "en", "about"] or ["", "about"]
  const maybe = segments[1];
  if (maybe && maybe in languages && maybe !== defaultLang) {
    segments.splice(1, 1);
  }

  return segments.join("/").replace(/^\//, ""); // bare path — no base, no locale
}

const cleanPath = toCleanPath(Astro.url.pathname);
const query = Astro.url.search; // preserve ?params on switch
---

<nav class="language-switcher" aria-label="Language">
  {
    Object.entries(languages).map(([lang, label]) => {
      const isActive = lang === currentLocale;
      const href = getRelativeLocaleUrl(lang, cleanPath) + query;
      return (
        <a
          href={href}
          hreflang={lang}
          lang={lang}
          aria-current={isActive ? "true" : undefined}
          class:list={["lang-link", { active: isActive }]}>
          {lang}
        </a>
      );
    })
  }
</nav>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
  }
  .lang-link {
    padding: 0.2rem 1rem;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .lang-link:hover {
    opacity: 1;
  }
  .lang-link.active {
    opacity: 1;
    font-weight: 600;
  }
  .lang-link:nth-child(1) {
    border-right: 1px solid #e7e7e7;
  }
</style>
