---
// src/components/ScrollToTop.astro
import { Icon } from "astro-icon/components";
---

<button
  id="scroll-to-top"
  class="translate-y-20 opacity-0"
  aria-label="Scroll to top"
>
  <Icon name="arrow-up" class="size-6 stroke-[2.5]" />
</button>

<script>
  const btn = document.getElementById("scroll-to-top");

  if (btn) {
    const SHOW_AFTER = 300; // px scrolled before the button appears
    let isVisible = false; // mirrors the markup's default (hidden) state
    let ticking = false; // rAF throttle latch

    const setVisible = (visible: boolean) => {
      if (visible === isVisible) return; // skip redundant DOM writes
      isVisible = visible;
      btn.classList.toggle("translate-y-20", !visible);
      btn.classList.toggle("opacity-0", !visible);
      btn.classList.toggle("translate-y-0", visible);
      btn.classList.toggle("opacity-100", visible);
    };

    // rAF-throttled: at most one check per frame, however many scroll
    // events the browser fires (high-refresh mice fire a LOT of them).
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        setVisible(window.scrollY > SHOW_AFTER);
        ticking = false;
      });
    };

    const scrollToTop = () => {
      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      // Route through Lenis — it owns the scroll position, so a native
      // scrollTo fights it and only "wins" on the second click.
      window.lenis?.scrollTo(0, {
        immediate: prefersReduced,
        duration: 1.2,
        force: true, // still scrolls even if Lenis was paused/stopped
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    btn.addEventListener("click", scrollToTop);

    onScroll(); // sync once in case the page loads already scrolled down
  }
</script>
