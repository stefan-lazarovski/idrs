          <div class="col-map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5134.199090901657!2d20.80096337729617!3d41.07604661524744!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1350c3611117153b%3A0x84c34dab510b125b!2sHotel%20Tino%20Sveti%20Stefan!5e1!3m2!1sen!2smk!4v1787232213824!5m2!1sen!2smk"
