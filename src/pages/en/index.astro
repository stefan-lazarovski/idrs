---
// src/pages/index.astro
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import HomeContent from "../../components/HomeContent.astro";
import { useTranslations } from "../../i18n/utils";

const lang = Astro.currentLocale ?? "mk";
const t = useTranslations(lang);

// Import Swiper styles directly into the component frontmatter if needed
import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";
---

<Layout
  title={t("meta.title")}
  description={t("meta.description")}
  ogImage="/seo/meta_image.jpg">
  <HomeContent lang={lang} />
</Layout>